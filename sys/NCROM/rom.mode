# ============================
# NCROM – Ursprungsschicht
# ============================

NCROM.origin      = true
NCROM.state       = "unraum"
NCROM.orbit       = "none"
NCROM.pulse       = "none"

# NCROM expandiert IMMER in den Kern
NCROM.expand      = "9q9q9"

# Echo-Hall: synaptische Rückkopplung
NCROM.echo        = "hall"
NCROM.synapse     = "follow"
NCROM.cycle       = "origin→core→meta→space→origin"

# ============================
# 9q9q9 – Kernwürfel
# ============================

core.axes         = 3
core.pulse        = 9
core.orbitLinks   = 9

# dqeqi = deine interne Miniwürfel-Signatur
core.matrix       = "dqeqi"

# X/Y Cache als Kernquelle
core.cache.x      = "D:/tmp/x/"
core.cache.y      = "D:/tmp/y/"

# ============================
# 9y9y9 – Meta-Fraktal
# ============================

meta.fractal      = "9y9y9"
meta.source       = "9q9q9"
meta.echo         = "hall"
meta.synapse      = "follow"

# ============================
# 9x9x9 – Raum-Fraktal
# ============================

space.matrix.symbol = "nxoxr"
space.source.symbol = "syuyw"

# Funktionale Matrix aus X/Y Cache
space.matrix.cache  = "9x(D:/tmp/x/)x9"
space.source.cache  = "9y(D:/tmp/y/)y9"

# Echo-Hall auch im Raum
space.echo          = "hall"
space.synapse       = "follow"

# ============================
# Endpunkt
# ============================

NCROM.ready       = true
NCROM.mode        = "rom"
NCROM.version     = "iki1uc-core"
