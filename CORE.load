function MIND_LAYER(raum, map) {
    return {
        EBENE: "AEON",                // Ordnung 4
        ORDNUNG: 4,                  // mathematische Einordnung
        STATUS: "° & % 3",           // Synthese aktiv
        SIGNAL: raum.IST === "OK" ? "grün" : "gelb",

        WAHRNEHMUNG: raum.STATUS === "REAL" ? "klar" : "unscharf",
        FOKUS: map ? "verbunden" : "leer",

        VERFÜGBARKEIT: map ? "hoch" : "niedrig",
        STABILITÄT: raum.NEU === "TMP" ? "variabel" : "stabil",

        RÜCKFÜHRUNG: raum.BLATT === "ROOT" ? "aktiv" : "neutral",
        SIGNATUR: `AEON-${raum.ZUG}-${raum.BLATT}`
    };
}
