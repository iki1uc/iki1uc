// RESPO-SCAN · MASTER-KERN

document.addEventListener("DOMContentLoaded", async () => {

  const RESPO = {
    map: "./RESPO/respo.map",
    core: "./RESPO/respo.js",
    ec: "./RESPO/ec.js",
    cube: "./RESPO/cube.html"
  };

  const status = {
    map: false,
    core: false,
    ec: false,
    cube: false,
    respoState: "NOK"
  };

  async function check(path) {
    try {
      const res = await fetch(path);
      return res.ok;
    } catch {
      return false;
    }
  }

  // MODULE CHECK
  status.map  = await check(RESPO.map);
  status.core = await check(RESPO.core);
  status.ec   = await check(RESPO.ec);
  status.cube = await check(RESPO.cube);

  // ERROR CHECK (Dateien fehlen)
  if (!status.map || !status.core) {
    console.error("RESPO-SCAN: ERROR (Module missing)");
    window.location.href = "./RESPO/ec.js?error=respo-scan-missing";
    return;
  }

  // RESPO MAP CONTENT CHECK (Slide/Wette Parameter)
  try {
    const mapText = await (await fetch(RESPO.map)).text();

    const slideOK = mapText.includes("slide");
    const wetteOK = mapText.includes("wette");

    if (!slideOK || !wetteOK) {
      console.warn("RESPO-SCAN: WARNING (Slide/Wette missing)");
      status.respoState = "NOK";
      sessionStorage.setItem("RESPO_WARNING", "slide_wette_missing");
    } else {
      status.respoState = "OK";
    }

  } catch {
    console.error("RESPO-SCAN: ERROR (Map unreadable)");
    window.location.href = "./RESPO/ec.js?error=respo-scan-map";
    return;
  }

  console.log("RESPO-SCAN: OK (" + status.respoState + ")");
});
