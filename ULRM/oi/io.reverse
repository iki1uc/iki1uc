{
  "id": "ULRM-OI-IO-REVERSE",
  "type": "io-mirror-io-reverse",
  "status": "ready",

  "axis": {
    "x": "mirror(reverse(io(x)))",
    "y": "mirror(reverse(io(y)))",
    "q": "mirror(reverse(io(q)))"
  },

  "narrativ": {
    "a": "input",
    "b": "mirror-io",
    "c": "output"
  },

  "axiome": {
    "swap": true,
    "replaceable": true,
    "set": [
      "AXIOM-IO",
      "AXIOM-O",
      "AXIOM-I"
    ]
  }
}
function ULRM_A(LAGE){
    return {
        x: LAGE.x,
        y: io_reverse(
               invert_reverse(
                   mirror_reverse(
                       LAGE.y - 1
                   )
               )
           ),
        z: LAGE.z,
        modi: "A",
        role: "left"
    };
}

