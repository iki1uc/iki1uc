{
  "id": "ULRM-IX-XI-REVERSE",
  "type": "io-cross-invert-reverse",
  "status": "ready",

  "axis": {
    "x": "cross(invert(reverse(x)))",
    "y": "cross(invert(reverse(y)))",
    "q": "cross(invert(reverse(q)))"
  },

  "narrativ": {
    "a": "input",
    "b": "cross-invert",
    "c": "output"
  },

  "axiome": {
    "swap": true,
    "replaceable": true,
    "set": [
      "AXIOM-X",
      "AXIOM-I",
      "AXIOM-Q"
    ]
  }
}

