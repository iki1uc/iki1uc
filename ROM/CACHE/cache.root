# CACHE.ROOT · MASTER-KERN

CACHE.ROOT.ID        = 36E
CACHE.ROOT.STATE     = active
CACHE.ROOT.MODE      = dynamic
CACHE.ROOT.VERSION   = 1.0

# ROOT-LINKS
CACHE.ROOT.ROM       = ./ROM/rom.map
CACHE.ROOT.RAM       = ./RAM/ram.map
CACHE.ROOT.AXIOM     = ./AXIOM/axiom.space
CACHE.ROOT.MATRIX    = ./MATRIX/matrix.692
CACHE.ROOT.CACHE     = ./CACHE/cache.map
CACHE.ROOT.GPU       = ./GPU/gpu.map
CACHE.ROOT.ERROR     = ./ERROR/error-router.item

# CACHE-MISS HANDLING
CACHE.MISS.THRESHOLD = 1%
CACHE.MISS.ACTION    = CPU-RECALIBRATION
CACHE.MISS.MODE      = auto
CACHE.MISS.STATE     = monitor

# CACHE-STAGE ROOT
CACHE.STAGE.1 = ROM-LOAD
CACHE.STAGE.2 = RAM-ALLOC
CACHE.STAGE.3 = AXIOM-SPACE
CACHE.STAGE.4 = MULTILAR-ZONE

# ROOT-READY
CACHE.ROOT.READY = true
