export const QUAD = {

    SIDES: 4,
    TYPE: "FORM",
    TARGET: "iki1uc.core",

    AXIOM: {
        SYN: { role: "sync", stable: true },
        FLX: { role: "flex", stable: true },
        VEC: { role: "vector", stable: true },
        TMP: { role: "temporal", stable: true } // Beispiel
    },

    resolve() {
        return {
            id: "QUAD_FORM",
            axioms: this.AXIOM,
            target: this.TARGET,
            ready: true
        };
    }
};
